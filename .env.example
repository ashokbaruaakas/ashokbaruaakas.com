# ──────────────────────────────────────────────
# Docker Compose / Deployment
# ──────────────────────────────────────────────
PROJECT_PREFIX=ashokbaruaakas

# Set by deploy.yml blue/green cutover (do not hand-edit on server)
# ACTIVE_SLOT=blue
# ACTIVE_SSR_URL=http://ssr_blue:13714
# BLUE_TRAEFIK_ENABLE=true
# GREEN_TRAEFIK_ENABLE=false
# BLUE_ROUTER_PRIORITY=200
# GREEN_ROUTER_PRIORITY=100
# COMPOSE_RUNTIME_OVERRIDE_FILE=compose.runtime.override.yaml

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_NAME="Ashok Barua Akas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://ashokbaruaakas.com.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_TIMEZONE=UTC
APP_PREVIOUS_KEYS=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

VITE_APP_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# Bcrypt
# ──────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ashokbaruaakas
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# ──────────────────────────────────────────────
# Session
# ──────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_TABLE=sessions
SESSION_CONNECTION=

# ──────────────────────────────────────────────
# Cache
# ──────────────────────────────────────────────
CACHE_STORE=database
# CACHE_PREFIX=

# ──────────────────────────────────────────────
# Queue
# ──────────────────────────────────────────────
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# ──────────────────────────────────────────────
# Broadcasting
# ──────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ──────────────────────────────────────────────
# Filesystem
# ──────────────────────────────────────────────
FILESYSTEM_DISK=local

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90

# ──────────────────────────────────────────────
# Memcached
# ──────────────────────────────────────────────
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=

# ──────────────────────────────────────────────
# Mail
# ──────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=0.0.0.0
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ashokbaruaakas@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# ──────────────────────────────────────────────
# Inertia SSR
# ──────────────────────────────────────────────
INERTIA_SSR_URL=http://127.0.0.1:13714

# ──────────────────────────────────────────────
# Passkeys / WebAuthn
# ──────────────────────────────────────────────
# PASSKEYS_USER_HANDLE_SECRET=

# ──────────────────────────────────────────────
# AWS / S3
# ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=
AWS_ENDPOINT=

# ──────────────────────────────────────────────
# Laravel Cloud / Development
# ──────────────────────────────────────────────
# PHP_CLI_SERVER_WORKERS=4